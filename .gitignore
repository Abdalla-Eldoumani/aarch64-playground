# Rust
emulator/target/
# Cargo.lock IS tracked. The wasm this crate builds runs in every visitor's
# browser, so the dependency set has to be the same one that was reviewed:
# untracked, Vercel and CI resolved caret ranges fresh on every build and
# ran whatever build scripts and proc macros that pulled in. The npm side
# is pinned by package-lock.json; this was the one unpinned surface.

# Node
node_modules/
web/node_modules/
web/.next/
web/out/
web/coverage/
web/tsconfig.tsbuildinfo
# Root package-lock.json is generated by the Vercel install step (so the
# root `next` declaration gets installed for framework detection). It's not
# the source of truth for web/ -- that lives in web/package-lock.json.
/package-lock.json

# WASM build output
web/lib/wasm/
web/lib/wasm-node/

# Secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local course material, not for the public repo. Consulted during
# development only; nothing from it ships.
cpsc355-kb/

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
.lighthouse/

# Web Template
web/content/lessons/lesson-template.json
