# Rust
emulator/target/
# Cargo.lock is tracked on purpose. The wasm this crate builds runs in every
# visitor's browser, so every build must use the exact dependency versions
# that were reviewed, the way web/package-lock.json pins the npm side.

# Node
node_modules/
web/node_modules/
web/.next/
web/out/
web/coverage/
# The service worker, written by every build with that build's file list
# (its source is web/lib/playground/sw.js).
web/public/sw.js
web/.vitest/
web/tsconfig.tsbuildinfo
# A root package-lock.json only appears after a local npm install here (the
# Vercel install passes --no-package-lock). The app's lock file is
# web/package-lock.json.
/package-lock.json

# WASM build output
web/lib/wasm/
web/lib/wasm-node/

# Secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
.lighthouse/

# Web Template
web/content/lessons/lesson-template.json
