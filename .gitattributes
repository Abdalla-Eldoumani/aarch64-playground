# Fixture and source files MUST stay LF on every checkout, regardless
# of platform. The WASM emulator emits LF in stdout/stderr, and the
# verify-corpus.js byte-for-byte fixture comparison breaks if Windows
# git's autocrlf converts these to CRLF on checkout.
*.stdout text eol=lf
*.stdin  text eol=lf
*.args   text eol=lf
*.s      text eol=lf
*.asm    text eol=lf
*.S      text eol=lf

# Shell scripts must be LF or bash on Linux refuses to run them.
*.sh text eol=lf

# The C corpus references are byte-compared against emulator output and
# against tools/sanitize.py's regeneration, so none of them may be
# rewritten at checkout. .out files carry program-controlled bytes and
# stay untranslated outright.
emulator/tests/c-corpus/*.out -text
emulator/tests/c-corpus/*.code text eol=lf
emulator/tests/c-corpus/*.c    text eol=lf
emulator/tests/c-corpus/*.flags text eol=lf
emulator/tests/addressing-freeze.txt text eol=lf
